# Port the microservice listens on
PORT=4001

# Supabase project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Arcadia tables live in the default "public" schema
SUPABASE_SCHEMA=public

# Names of the tables this service reads
REVIEWS_TABLE=reviews
LOCATIONS_TABLE=locations

# Default number of top locations to return when ?limit= is not supplied
TOP_LOCATIONS_DEFAULT_LIMIT=10

# Locations with fewer than this many reviews are excluded from the top list
TOP_LOCATIONS_MIN_REVIEWS=5
